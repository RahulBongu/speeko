{
  "name": "@speeko/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/export-web.js",
    "sync:licenses": "node scripts/sync-licenses.mjs",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "./jest.preset.js",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@speeko/core": "workspace:*",
    "expo": "~55.0.32",
    "expo-asset": "~55.0.20",
    "expo-av": "~16.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-modules-core": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "query-string": "9.5.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "^55.0.25",
    "eslint": "8.57.1",
    "eslint-config-expo": "55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "typescript": "^5.9.3"
  }
}
