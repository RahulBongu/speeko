{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleResolution": "bundler",
    "strict": true,

    "paths": { "@/*": ["./*"] }
