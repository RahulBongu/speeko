{
  "expo": {
    "name": "Speeko",
    "slug": "speeko",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "speeko",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "./plugins/withQaLoopbackCleartext",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "http://localhost:3001",
      "webOrigin": "http://localhost:3000"
    },
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16a34a",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "package": "com.speeko.app"
    },
    "ios": {
      "bundleIdentifier": "com.speeko.app"
    }
  }
}
