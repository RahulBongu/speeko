{
  "expo": {
    "name": "Speeko",
    "slug": "speeko",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "speeko",
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#16a34a", "foregroundImage": "./assets/icon.png" },
      "package": "com.speeko.app"
    },
    "ios": { "bundleIdentifier": "com.speeko.app" }
  }
}
