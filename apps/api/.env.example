# Speeko API — copy to .env for local development.

PORT=3001
HOST=0.0.0.0

# Better Auth signs session cookies with this value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# Origins allowed to call the API (comma-separated). The web app by default.
CLIENT_ORIGINS=http://localhost:3000

# Leave DATABASE_URL unset to use the zero-setup pglite database in apps/api/data.
# Set it to use Postgres instead:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/speeko

# Rate limiting behind a reverse proxy.
# TRUST_PROXY_HOPS=0 ignores X-Forwarded-For (correct when this process receives
# traffic directly). Render forwards from one load-balancer hop: set 1 there.
TRUST_PROXY_HOPS=0

# Shared secret with the web proxy (Vercel middleware). When set, the API honours
# x-speeko-client-ip only if x-speeko-proxy-secret matches this value. Leave
# unset locally; production proxy mode requires the same value on web + API.
# API_PROXY_SECRET=replace-with-a-long-random-string

# Test-only escape hatch. RATE_LIMIT_DISABLED=1 turns off request limiting and
# is used by the E2E suite; never set it in a deployed environment.
# RATE_LIMIT_DISABLED=1

# Optional override for the course JSON directory (defaults to the repo's
# content/dist bundle). Useful for isolated content tests only.
# CONTENT_DIR=/path/to/course/json

# Optional AI conversation provider configuration (names only; never put real
# values in this file). Both variables must be present for /api/ai/status to
# report available=true. The conversation route is still an intentional 503:
# no provider client is implemented in this build, so setting these values
# alone does not enable conversations. The owner must authorize and implement
# a provider before this gate can change.
# AI_API_KEY=replace-with-provider-key
# AI_API_URL=https://provider.example/v1/chat/completions
