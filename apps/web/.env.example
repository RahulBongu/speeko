# Speeko web - copy to .env.local for local development.

# Where the browser sends API requests.
# - Absolute URL: direct API calls (the local default).
# - `same-origin`: call /api/* on this origin; middleware.ts proxies it to
#   API_PROXY_TARGET. Use this on the free Vercel + Render stack so the session
#   cookie stays first-party (SameSite=Lax would drop a cross-site cookie).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side proxy target for /api/* when NEXT_PUBLIC_API_URL=same-origin.
# Read by middleware at runtime; also set it in the deployment environment.
# API_PROXY_TARGET=https://speeko-api.onrender.com

# Shared secret forwarded with the client IP. Must match the API's
# API_PROXY_SECRET. If unset, the proxy still works but the API keys rate
# limits on Vercel/Render egress addresses (one shared budget).
# API_PROXY_SECRET=replace-with-a-long-random-string

# The fox mascot uses the bundled SVG + CSS rig. No hosted animation service,
# Rive URL, or paid asset is required or read by the app.
